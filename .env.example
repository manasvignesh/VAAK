# Server Port (defaults to 3000)
PORT=3000

# Optional: Deepgram API Key for live Nova-3 multilingual streaming speech-to-text
# App starts and runs in Demo Mode without this key.
DEEPGRAM_API_KEY=

# Optional: Google Gemini API Key for live translation and evidence-linked study notes
# App starts and runs in Demo Mode without this key.
GEMINI_API_KEY=

# Optional: Gemini model overrides
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Public deployment abuse protection limits
LIVE_SERVICES_ENABLED=true
GLOBAL_DAILY_AI_LIMIT=250
GLOBAL_DAILY_AUDIO_MINUTES=120
GLOBAL_MAX_CONCURRENT_WS=25
